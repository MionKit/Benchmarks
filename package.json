{
  "name": "mion-benchmarks",
  "version": "1.0.0",
  "private": true,
  "description": "Benchmarks for mion framework.",
  "main": "index.js",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">= 20.0.0",
    "pnpm": ">= 11.0.0"
  },
  "scripts": {
    "start": "node benchmark.js",
    "compare": "node benchmark.js compare --",
    "compare-t": "node benchmark.js compare -t",
    "compare:summary": "node benchmark.js compare -u",
    "test": "standard | snazzy",
    "standard": "standard | snazzy",
    "metrics:run": "node metrics/startup.js",
    "metrics:summary": "node metrics/process-results.js -u",
    "metrics": "pnpm run metrics:run && pnpm run metrics:summary",
    "build": "rimraf ./_compiled-apps && tsc --project tsconfig.json",
    "print-servers": "node benchmark-compare.js -u -b servers",
    "bench-servers": "node benchmark-bench.js y 100 10 40 servers",
    "test-bench-servers": "node benchmark-bench.js y 100 10 4 servers",
    "servers": "pnpm run bench-servers && pnpm run print-servers",
    "print-servers-hello": "node benchmark-compare.js -u -b servers-hello",
    "bench-servers-hello": "node benchmark-bench.js y 100 10 40 servers-hello",
    "servers-hello": "pnpm run bench-servers-hello && pnpm run print-servers-hello",
    "report": "pnpm run servers && pnpm run servers-hello && pnpm run metrics",
    "deepkit-install": "deepkit-type-install",
    "mionlink": "node scripts/mionlink.js",
    "mionupdate": "node scripts/mionupdate.js",
    "copy-mion-tarballs": "bash scripts/copy-mion-tarballs.sh"
  },
  "bin": {
    "benchmark": "./benchmark.js"
  },
  "repository": "https://github.com/fastify/benchmarks.git",
  "author": "Ma jerez",
  "contributors": [
    {
      "name": "Ma Jerez"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@deepkit/app": "1.0.1-alpha.119",
    "@deepkit/filesystem": "1.0.1-alpha.114",
    "@deepkit/framework": "1.0.1-alpha.119",
    "@deepkit/http": "1.0.1-alpha.119",
    "@deepkit/logger": "1.0.1-alpha.119",
    "@deepkit/type": "1.0.1-alpha.119",
    "@hapi/hapi": "21.3.2",
    "@hono/node-server": "1.4.1",
    "@mionjs/client": "file:./mion-tarballs/mionjs-client.tgz",
    "@mionjs/core": "file:./mion-tarballs/mionjs-core.tgz",
    "@mionjs/platform-bun": "file:./mion-tarballs/mionjs-platform-bun.tgz",
    "@mionjs/platform-node": "file:./mion-tarballs/mionjs-platform-node.tgz",
    "@mionjs/router": "file:./mion-tarballs/mionjs-router.tgz",
    "@mionjs/run-types": "file:./mion-tarballs/mionjs-run-types.tgz",
    "@mionjs/type-formats": "file:./mion-tarballs/mionjs-type-formats.tgz",
    "@trpc/server": "9.27.2",
    "autocannon": "7.0.1",
    "autocannon-compare": "0.4.0",
    "benchmark": "2.1.4",
    "chalk": "4.1.2",
    "cli-table": "0.3.1",
    "commander": "9.0.0",
    "connect": "3.6.6",
    "cors": "2.8.5",
    "dns-prefetch-control": "0.3.0",
    "egg": "3.0.0",
    "express": "4.16.4",
    "fastify": "4.10.0",
    "frameguard": "4.0.0",
    "hide-powered-by": "1.0.0",
    "hono": "3.12.6",
    "hsts": "2.1.0",
    "ienoopen": "1.0.0",
    "inquirer": "8.0.0",
    "make-promises-safe": "5.1.0",
    "restify": "11.1.0",
    "router": "1.3.3",
    "server-base": "7.1.23",
    "server-base-router": "7.1.23",
    "total.js": "3.2.4",
    "x-xss-protection": "2.0.0"
  },
  "devDependencies": {
    "@deepkit/core": "1.0.1-alpha.114",
    "@deepkit/type-compiler": "1.0.1-alpha.117",
    "@mionjs/devtools": "file:./mion-tarballs/mionjs-devtools.tgz",
    "@types/node": "16.11.6",
    "pidusage": "3.0.2",
    "puppeteer": "20.8.0",
    "rimraf": "5.0.1",
    "snazzy": "9.0.0",
    "standard": "17.0.0",
    "typescript": "5.3.3"
  }
}
